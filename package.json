{
  "name": "onizy",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "preview": "node scripts/preview.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:structure": "node scripts/check-project.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "test": "node scripts/test.mjs",
    "test:auth": "node scripts/test.mjs src/features/auth",
    "test:design": "node scripts/test.mjs src/design-system src/shared",
    "test:learning": "node scripts/test.mjs src/domain src/features/library src/features/study src/features/progress",
    "check": "npm run check:structure && npm run check:assets && npm run typecheck && npm run lint && npm run format:check && npm test",
    "doctor": "expo-doctor",
    "bundle:check": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "57.0.4",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
